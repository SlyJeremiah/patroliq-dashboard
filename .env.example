# PATROLIQ API (Django on Render). Must end with /api/v1/
VITE_API_URL=https://patroliq-api.onrender.com/api/v1/

# Basemap style (MapLibre style JSON URL). Default: OpenFreeMap Liberty (no key required).
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Optional satellite raster tiles ({z}/{y}/{x} or {z}/{x}/{y}) for the Satellite layer toggle, with attribution.
VITE_SATELLITE_TILES=
VITE_SATELLITE_ATTRIBUTION=
